# -----------------------------------------------------------------------------
# RideShare Pro — Environment Configuration
# -----------------------------------------------------------------------------

# Secret key used for signing and verifying JWT authentication tokens
JWT_SECRET=super-secret-jwt-key-replace-this-in-production

# Node environment (development, production, test)
NODE_ENV=development

# Optional: Path to custom SQLite database file
# If unset, defaults to 'rideshare.db' in the project root.
# On Render with a persistent disk, set this to e.g. /var/data/rideshare.db
# DATABASE_PATH=/var/data/rideshare.db

# Optional: Port override (Next.js default: 3000)
# PORT=3000

# Disable Next.js anonymous telemetry collection
NEXT_TELEMETRY_DISABLED=1
